# ==============================================================================
# eFootball Co-op Discord Statistics Bot - Environment Configuration
# ==============================================================================

# Required: Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_bot_token_here

# Required: Target Discord Server (Guild) ID where commands will be registered
DISCORD_GUILD_ID=123456789012345678

# Storage: Local Excel workbook path (relative or absolute)
WORKBOOK_PATH=data/matches.xlsx

# Upload limit: Maximum allowed screenshot file size in Megabytes
MAX_IMAGE_MB=10

# Security (Optional): Restrict bot commands to a specific Discord channel ID
# Leave empty to allow commands in any guild text channel
ALLOWED_CHANNEL_ID=

# Security (Optional): Role ID authorized for administrative operations like /delete-match
# If empty, only users with Discord 'Administrator' permissions can delete matches
ADMIN_ROLE_ID=

# OCR (Optional): Path to Tesseract executable (primarily for Windows setups)
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave empty if 'tesseract' is accessible in system PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
